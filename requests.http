@baseUrl = http://localhost:8080/api/v1

### Supported handlers
GET {{baseUrl}}/job-types

### Submit an echo job
# @name submitEcho
POST {{baseUrl}}/jobs
Content-Type: application/json
Idempotency-Key: rest-client-echo-001

{
  "type": "ECHO",
  "payload": {
    "message": "this is a diff payload"
  },
  "maxAttempts": 3,
  "priority": 2
}

### Inspect the submitted echo job
@echoJobId = {{submitEcho.response.body.$.id}}
GET {{baseUrl}}/jobs/{{echoJobId}}

### Submit a job that fails once, then succeeds on retry
# @name submitRetryDemo
POST {{baseUrl}}/jobs
Content-Type: application/json

{
  "type": "FAIL_ONCE",
  "payload": {
    "message": "Recovered after retry"
  },
  "maxAttempts": 3
}

### Inspect retry demo
@retryJobId = {{submitRetryDemo.response.body.$.id}}
GET {{baseUrl}}/jobs/{{retryJobId}}

### Submit a five-second job (repeat this request to observe bounded concurrency)
POST {{baseUrl}}/jobs
Content-Type: application/json

{
  "type": "WAIT",
  "payload": {
    "durationMs": 5000
  },
  "maxAttempts": 1
}

### List recent jobs
GET {{baseUrl}}/jobs?limit=20

### Filter by status
GET {{baseUrl}}/jobs?status=SUCCEEDED&limit=20

### Cancel a pending job (replace ID)
DELETE {{baseUrl}}/jobs/9068c775-429a-4a14-9ec1-59ac320ba0f1

### Health and metrics
GET http://localhost:8080/actuator/health

GET http://localhost:8080/actuator/metrics


### Crash recovery test
# @name crashRecovery
POST {{baseUrl}}/jobs
Content-Type: application/json
Idempotency-Key: crash-recovery-test-003

{
  "type": "WAIT",
  "payload": {
    "durationMs": 30000
  },
  "maxAttempts": 3
}

### Check job status
GET {{baseUrl}}/jobs/87249689-1079-464a-b4f9-62062d9bc1e1

### Retry exhaustion test
# @name retryExhaustion
POST {{baseUrl}}/jobs
Content-Type: application/json

{
  "type": "FAIL_ONCE",
  "payload": {
    "message": "This job should never succeed"
  },
  "maxAttempts": 1
}